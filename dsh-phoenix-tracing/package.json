{
  "name": "dsh-phoenix-tracing",
  "version": "0.2.0",
  "description": "Arize Phoenix tracing backend for the DeepSeek Harness: projects session telemetry records onto proper OTel spans (OpenInference) and exports them over OTLP/HTTP to Phoenix",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./mapper": "./lib/mapper.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "cordis",
    "arize",
    "phoenix",
    "opentelemetry",
    "tracing",
    "openinference",
    "llm"
  ],
  "scripts": {
    "test": "node --test tests/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-anonymous-user-id": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session-telemetry": ">=0.1.2-rc.1 <0.2.0"
  }
}
